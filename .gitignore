# ==============================================================================
# PureCast — Git Ignore Configuration
# ==============================================================================

# ── 1. Python & Bytecode ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── 2. Virtual Environments ───────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.conda/

# ── 3. Frontend & Node.js ─────────────────────────────────────────────────────
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
*/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.eslintcache
*.tsbuildinfo

# ── 4. Environment Variables & Secrets ────────────────────────────────────────
# NEVER push environment configs or private keys to git
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
!docker/mosquitto/*.conf

# ── 5. Databases & Local Storage ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
purecast.db
test_purecast.db
dump.rdb

# ── 6. Testing, Linting & Coverage ────────────────────────────────────────────
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.lcov
.tox/
.nox/

# ── 7. IDE & Editor Artifacts ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.pydevproject
.settings/

# ── 8. Operating System Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── 9. Logs & Runtime ─────────────────────────────────────────────────────────
*.log
logs/
*.pid
*.seed
*.pid.lock

# ── 10. Large ML Models & Binary Weights ──────────────────────────────────────
models/*.bin
models/*.pkl
models/*.joblib
models/*.onnx
models/*.pt
models/*.pth
models/*.h5
models/*.tflite

# ── 11. Data Dumps & Large Datasets ───────────────────────────────────────────
*.csv
*.parquet
*.feather
!tests/golden/*.csv

# ── 12. Docker & Container Volumes ────────────────────────────────────────────
docker/volumes/
